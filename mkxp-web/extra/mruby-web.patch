+/* WEB PORT: integer division rounding toward -infinity (Ruby semantics). */
+static mrb_int
+web_floor_idiv(mrb_int x, mrb_int y)
+{
+  mrb_int q = x / y;
+  if ((x % y != 0) && ((x < 0) != (y < 0))) q--;
+  return q;
+}
