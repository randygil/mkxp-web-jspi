+/* WEB PORT (mkxp-web): Array/String have no iv slot in mruby, but RGSS code
+ * (e.g. Essentials PBAnimation < Array) stores ivars on them. Keep those in a
+ * side table: $__mkxpweb_ext_iv[object_id] = [obj, {sym => value}]. Holding obj
+ * keeps it alive, so an object_id is never reused while its entry exists. */
+#include <mruby/hash.h>
+static mrb_bool
+ext_iv_p(mrb_value obj)
+{
+  return mrb_type(obj) == MRB_TT_ARRAY || mrb_type(obj) == MRB_TT_STRING;
+}
+
+static mrb_value
+ext_iv_hash(mrb_state *mrb, mrb_value obj, mrb_bool create)
+{
+  mrb_sym gsym = mrb_intern_lit(mrb, "$__mkxpweb_ext_iv");
+  mrb_value tbl = mrb_gv_get(mrb, gsym);
+  mrb_value key, ent;
+  if (!mrb_hash_p(tbl)) {
+    if (!create) return mrb_nil_value();
+    tbl = mrb_hash_new(mrb);
+    mrb_gv_set(mrb, gsym, tbl);
+  }
+  key = mrb_fixnum_value(mrb_obj_id(obj));
+  ent = mrb_hash_get(mrb, tbl, key);
+  if (mrb_nil_p(ent)) {
+    if (!create) return mrb_nil_value();
+    ent = mrb_ary_new_capa(mrb, 2);
+    mrb_ary_push(mrb, ent, obj);
+    mrb_ary_push(mrb, ent, mrb_hash_new(mrb));
+    mrb_hash_set(mrb, tbl, key, ent);
+  }
+  return mrb_ary_ref(mrb, ent, 1);
+}
