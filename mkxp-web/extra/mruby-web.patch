 }
 
+/* WEB PORT PERF: real hash index for symbol lookup.
+ * Stock 2.1.2 keeps 256 buckets chained through an 8-bit `prev` delta; as soon as two
+ * consecutive symbols of a bucket are more than 255 ids apart (routine once a program has
+ * a few thousand symbols) the lookup falls back to a LINEAR backwards scan of the whole
+ * table with a memcmp per entry.
+ * Pokemon Essentials + plugins have tens of thousands of symbols and intern at runtime
+ * (send / respond_to? / to_sym / instance_variable_get), which made ~90% of the CPU time
+ * find_symbol+memcmp. This open-addressing index (sym ids, linear probing) makes it O(1).
+ * One index per mrb_state (mkxp and mrbc each use a single state). */
+#include <stdlib.h>
+static struct {
+  mrb_state *mrb;
+  uint32_t *slot;
+  uint32_t mask;
+  uint32_t n;
+} symidx_tab;
+
+static uint32_t
+symhash32(const char *key, size_t len)
+{
+  uint32_t hash = 2166136261u;
+  size_t i;
+  for (i = 0; i < len; ++i) {
+    hash ^= (uint8_t)key[i];
+    hash *= 16777619u;
+  }
+  return hash;
+}
+
+static void
+symidx_put(mrb_state *mrb, mrb_sym i)
+{
+  uint32_t h = symhash32(mrb->symtbl[i].name, mrb->symtbl[i].len) & symidx_tab.mask;
+  while (symidx_tab.slot[h]) h = (h + 1) & symidx_tab.mask;
+  symidx_tab.slot[h] = (uint32_t)i;
+  symidx_tab.n++;
+}
+
+static void
+symidx_rebuild(mrb_state *mrb, size_t want)
+{
+  uint32_t cap = 1024;
+  mrb_sym i;
+  while (cap < want * 2) cap <<= 1;
+  free(symidx_tab.slot);
+  symidx_tab.slot = (uint32_t*)calloc(cap, sizeof(uint32_t));
+  symidx_tab.mask = cap - 1;
+  symidx_tab.n = 0;
+  symidx_tab.mrb = mrb;
+  for (i = 1; i <= mrb->symidx; i++) symidx_put(mrb, i);
+}
+
+static void
+symidx_ensure(mrb_state *mrb)
+{
+  if (symidx_tab.mrb != mrb || !symidx_tab.slot) symidx_rebuild(mrb, (size_t)mrb->symidx + 1);
+}
+
