# Build context for the DEPLOY image (deploy/Dockerfile, context = repo root).
# Whitelist only what the image copies: the built game + the deploy config.
# Everything else (mkxp-web/deps ~GBs, mkxp-web/src, .git, scripts_src, ...) is
# excluded so the context stays ~= the 395MB game dir.
*
!mkxp-web
!deploy
!gen-pack.py

# under mkxp-web, keep ONLY the built game
mkxp-web/*
!mkxp-web/build

# non-served / dev-only bits inside build/
mkxp-web/build/.claude
mkxp-web/build/.htaccess
mkxp-web/build/**/*.bak
mkxp-web/build/**/*.orig
# the offline pack is rebuilt inside the image (deploy/Dockerfile)
mkxp-web/build/gamepack-*
mkxp-web/build/gamepack.json

# never send VCS / OS cruft even if a rule above would include it
.git
**/.DS_Store
*.log
